{
  "name": "strasedu",
  "version": "2.1.1",
  "description": "StrasEdu — lanceur d'applications pédagogiques pour les établissements scolaires",
  "main": "main.js",
  "author": "STRAS EDU",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "admin": "electron admin/main.js",
    "selfcheck:admin": "electron admin/selfcheck.js",
    "preview": "electron scripts/preview.js",
    "icons": "python scripts/generate-icons.py",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:all": "npm run build && npm run build:portable && npm run build:admin",
    "fix-builder-cache": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fix-builder-cache.ps1",
    "build:admin": "electron-builder --config electron-builder.admin.json --win",
    "release": "node scripts/publish-release.js",
    "release:dry": "node scripts/publish-release.js --dry-run"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.strasedu.app",
    "productName": "StrasEdu",
    "copyright": "© STRAS EDU",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "lib/**/*",
      "styles/**/*",
      "renderer/**/*",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "extraResources": [
      {
        "from": "apps.json",
        "to": "apps.json"
      },
      {
        "from": "icons",
        "to": "icons",
        "filter": [
          "tray*.png",
          "icon.ico",
          "icon.png"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico",
      "artifactName": "StrasEdu-${version}-${arch}-setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "StrasEdu",
      "uninstallDisplayName": "StrasEdu ${version}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "icons/icon.ico",
      "language": "1036"
    },
    "portable": {
      "artifactName": "StrasEdu-${version}-portable.${ext}",
      "splashImage": "build/splash.bmp"
    }
  },
  "allowScripts": {
    "electron": true
  },
  "overrides": {
    "yauzl": "^3.3.1"
  }
}
